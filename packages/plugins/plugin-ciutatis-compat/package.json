{
  "name": "@ciutatis/plugin-ciutatis-compat",
  "version": "0.1.0",
  "description": "Ciutatis fork compatibility plugin — catalogs disabled upstream features and civic branding aliases used during Paperclip merges",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./compat": "./src/compat/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "tsc && node scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@paperclipai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
